{
  "dataset_id": "day04_v2_group_eval",
  "dataset_role": "eval",
  "description": "10 cases for group G16",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "T01_youtube_summarizer_single",
      "phase": "B",
      "query": "Tóm tắt video youtube này giúp mình nhé: https://www.youtube.com/watch?v=dQw4w9WgXcQ",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "youtube_summarizer",
            "args": {
              "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Gọi tool youtube_summarizer khi có URL hợp lệ."
      }
    },
    {
      "id": "T02_weather_forecast_single",
      "phase": "B",
      "query": "Thời tiết ở Tokyo hôm nay thế nào?",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "weather_forecast",
            "args": {
              "location": "Tokyo"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Gọi tool thời tiết với tham số thành phố đúng."
      }
    },
    {
      "id": "T03_crypto_tracker_single",
      "phase": "B",
