      "expect": {
        "tool_calls": [
          {
            "name": "crypto_tracker",
            "args": {
              "symbol": "ETH"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Gọi tool crypto với mã giao dịch chính xác."
      }
    },
    {
      "id": "T04_github_explorer_single",
      "phase": "B",
      "query": "Tìm kiếm các project AI bằng Python đang hot trên Github.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "github_explorer",
            "args": {
              "query": "AI",
